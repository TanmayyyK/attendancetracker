{
  "expo": {
    "name": "Attendance Manager",
    "slug": "attendance-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/attendance-manager-icon-v4.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/attendance-manager-icon-v4.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24172B",
        "foregroundImage": "./assets/images/attendance-manager-icon-v4.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tanmayk18.attendancemanager"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050A18",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 200
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe1835ac-9c4f-4815-a4c5-5200127f6871"
      }
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#1F418A"
    }
  }
}
